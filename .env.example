# ======================================================================
# Defect Management Agentic AI Solution - Environment configuration
# Copy this file to ".env" and fill in the values. The .env file is read
# automatically on startup. NEVER commit real secrets.
# ======================================================================

# --- Data source -------------------------------------------------------
# Path to the centralized Excel workbook (the MVP data source).
DEFECT_WORKBOOK_PATH=data/Cockpit_Issue_Tracker.xlsm

# GitHub repository used to build issue URLs (owner/repo).
GITHUB_REPO=CE-Neurostack/celanese-cockpit

# --- Azure OpenAI (Agentic AI chatbot) ---------------------------------
# If these are set, the chatbot uses Azure OpenAI with function-calling.
# If they are missing, the chatbot automatically runs in offline
# rule-based mode (no LLM calls) and everything else keeps working.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2024-12-01-preview

# --- Live extraction (optional Service Bot, OFF by default) ------------
# Only needed if you enable live GitHub / Smartsheet extraction instead of
# the Excel workbook. Leave blank for the Excel-based MVP.
GITHUB_TOKEN=
GITHUB_OWNER=
GITHUB_REPO_NAME=
SMARTSHEET_ACCESS_TOKEN=
SMARTSHEET_SHEET_ID=

# --- Service Bot schedule ----------------------------------------------
# Interval (minutes) for the automated extraction refresh. 0 disables the
# background scheduler (manual refresh only).
SERVICE_BOT_INTERVAL_MINUTES=0

# --- Server bind address -----------------------------------------------
# Host/port the web app binds to.
HOST=127.0.0.1
PORT=8000

# --- App metadata ------------------------------------------------------
APP_TITLE=Defect Management Agentic AI
APP_VERSION=1.0.0

# --- Pagination --------------------------------------------------------
# Default and maximum page size for the defects table API.
DEFAULT_PAGE_SIZE=25
MAX_PAGE_SIZE=500

# --- Data cleansing ----------------------------------------------------
# Comma-separated GitHub issue titles treated as test/placeholder records
# and excluded from the defect universe (case-insensitive, exact match).
PLACEHOLDER_GITHUB_TITLES=test issue,test,dummy issue,sample issue,placeholder

# --- Security ----------------------------------------------------------
# Secret used to sign session tokens. Change this in any real deployment.
APP_SECRET_KEY=change-me-in-production

# Salt mixed into password hashes before SHA-256.
AUTH_PASSWORD_SALT=dm-salt::

# Session token lifetime in hours.
SESSION_TTL_HOURS=8

# Demo user directory. Entries separated by ";", fields by "|":
#   username|password|role|display name
# Roles: Administrator, Project Manager, Developer, Business User, Read-Only User
# Replace with SSO / a real user store in production.
DEMO_USERS=admin|admin123|Administrator|Administrator;pm|pm123|Project Manager|Project Manager;dev|dev123|Developer|Developer;user|user123|Business User|Business User;viewer|viewer123|Read-Only User|Read-Only User
