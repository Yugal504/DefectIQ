# =============================================================================
# DefectIQ AI Solution - single consolidated configuration
# -----------------------------------------------------------------------------
# One .env for the whole project: the extraction bot (extraction/) AND the
# dashboard + chatbot (app/). NEVER commit real secrets (see .gitignore).
# Only variables actually read by the code are kept here.
# =============================================================================

# ---------------------------------------------------------------------------
# GitHub (extraction login + export)
# ---------------------------------------------------------------------------
GITHUB_USERNAME=
GITHUB_PASSWORD=
GITHUB_TOKEN=
GITHUB_REPO_URL=https://github.com/CE-Neurostack/celanese-cx-cockpit
GITHUB_LOGIN_URL=https://github.com/login
# Unique key used to match GitHub rows during the data-load upsert.
GITHUB_UNIQUE_KEY=IssueID
GITHUB_MERGE_KEY=IssueID
# owner/repo used to build issue links in the dashboard.
GITHUB_REPO=CE-Neurostack/celanese-cx-cockpit

# ---------------------------------------------------------------------------
# Smartsheet (extraction login + export)
# ---------------------------------------------------------------------------
# org = File menu; personal = More options menu.
SERVICE_TYPE=org
SMARTSHEET_USERNAME=
SMARTSHEET_PASSWORD=
SMARTSHEET_LOGIN_URL=https://app.smartsheet.com/login
SMARTSHEET_SHEET_NAME=Agentic AI - Action Tracker
SMARTSHEET_SHEET_URL=https://app.smartsheet.com/sheets/QcrcjgvV6xqj854VhGPmpWQFP879q69x74W7Jw31?view=grid
SMARTSHEET_MERGE_KEY=Action ID

# ---------------------------------------------------------------------------
# Browser (driven over the DevTools Protocol - no WebDriver needed)
# ---------------------------------------------------------------------------
# If BROWSER_PATH is blank, installed Microsoft Edge is used automatically,
# then CHROME_PATH as a fallback.
BROWSER_PATH=
REMOTE_DEBUG_PORT=9222
CHROME_PATH=C:\PortableApps\GoogleChromePortable\App\Chrome-bin\chrome.exe
# Dedicated automation profile directory (keeps your personal profile clean).
CHROME_PROFILE_DIR=C:\PortableApps\automation_profile

# ---------------------------------------------------------------------------
# File paths (all relative to this project root)
# ---------------------------------------------------------------------------
SCRIPT_PATH=script.txt
GITHUB_DOWNLOAD_PATH=downloads\github
SMARTSHEET_DOWNLOAD_PATH=downloads\smartsheet

# The ONE master tracker workbook: the extraction step refreshes it and the
# dashboard reads it. Keep MASTER_EXCEL_PATH and DEFECT_WORKBOOK_PATH pointed
# at the same file.
MASTER_EXCEL_PATH=data\Cockpit_Issue_Tracker.xlsm
DEFECT_WORKBOOK_PATH=data/Cockpit_Issue_Tracker.xlsm
# How the data-load step merges exports into the master sheets:
#   upsert  = append new rows, skip duplicates, update changed rows (default)
#   append  = add every source row below existing data (no dedup)
#   replace = clear the sheet then write the fresh snapshot
LOAD_MODE=upsert

# ---------------------------------------------------------------------------
# Extraction timeouts (seconds)
# ---------------------------------------------------------------------------
DOWNLOAD_TIMEOUT=120
MFA_WAIT_TIMEOUT=300

# ---------------------------------------------------------------------------
# Dashboard server (app/) - URL opened after extraction finishes
# ---------------------------------------------------------------------------
HOST=127.0.0.1
PORT=8000
AGENT_URL=http://127.0.0.1:8000
# Browser used to OPEN THE DASHBOARD. Corporate Edge is often forced into
# Internet Explorer (IE) mode for local URLs (blue "e" icon in the address
# bar); IE's engine breaks the dashboard. Leave blank to auto-prefer Chrome
# (CHROME_PATH above is also used), or set an explicit Chrome .exe here.
DASHBOARD_BROWSER_PATH=
APP_TITLE=Defect Management Agentic AI
APP_VERSION=1.0.0

# Write dashboard UPDATE/DELETE back into the workbook's "GitHub Export" and
# "Smart Sheet Export" sheets via Excel COM (preserves PivotTables/macros; the
# "Issue Statuses" sheet recomputes via its VLOOKUPs). Needs Microsoft Excel +
# pywin32 installed. Set to false to keep edits in the dashboard only.
EXCEL_WRITEBACK_ENABLED=true

# ---------------------------------------------------------------------------
# Azure OpenAI (Agentic AI chatbot). If blank, the chatbot runs offline in a
# deterministic rule-based mode and everything else still works.
# ---------------------------------------------------------------------------
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=gpt-4.1
AZURE_OPENAI_API_VERSION=2024-12-01-preview

# ---------------------------------------------------------------------------
# Live API extraction (optional, OFF by default). Only used by the dashboard's
# internal service bot; leave blank for the Excel-based workflow.
# ---------------------------------------------------------------------------
GITHUB_OWNER=
GITHUB_REPO_NAME=
SMARTSHEET_ACCESS_TOKEN=
SMARTSHEET_SHEET_ID=
SERVICE_BOT_INTERVAL_MINUTES=0

# ---------------------------------------------------------------------------
# Pagination
# ---------------------------------------------------------------------------
DEFAULT_PAGE_SIZE=25
MAX_PAGE_SIZE=500

# ---------------------------------------------------------------------------
# Data cleansing - GitHub titles treated as test/placeholder and excluded.
# ---------------------------------------------------------------------------
PLACEHOLDER_GITHUB_TITLES=test issue,test,dummy issue,sample issue,placeholder

# ---------------------------------------------------------------------------
# Security
# ---------------------------------------------------------------------------
APP_SECRET_KEY=change-me-in-production
AUTH_PASSWORD_SALT=dm-salt::
SESSION_TTL_HOURS=8
# Demo user directory: entries separated by ";", fields by "|":
#   username|password|role|display name
DEMO_USERS=admin|admin123|Administrator|Administrator;pm|pm123|Project Manager|Project Manager;dev|dev123|Developer|Developer;user|user123|Business User|Business User;viewer|viewer123|Read-Only User|Read-Only User
